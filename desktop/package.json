{
  "name": "amcy-trader-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first AMCY Trader inventory, checkout, customer and invoice desktop software",
  "author": "AMCY Trader",
  "main": "main.cjs",
  "build": {
    "appId": "com.amcy.trader",
    "electronVersion": "44.4.3",
    "productName": "AMCY Trader",
    "artifactName": "AMCY-Trader-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "amcy",
        "to": "amcy"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AMCY Trader"
    }
  }
}
